# ===== Global =====
NODE_ENV=development

# ===== PostgreSQL =====
POSTGRES_USER=toeic
POSTGRES_PASSWORD=toeic
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_PORT=7379

REDIS_URL=redis://localhost:7379
# ===== RabbitMQ =====
RABBITMQ_URL=amqp://toeic:toeic@localhost:5772
RABBITMQ_EXCHANGE=toeic.events

# ===== MinIO =====
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost:19000
MINIO_BUCKET=toeic-media

# ===== Elasticsearch =====
ELASTICSEARCH_PORT=19200
ELASTICSEARCH_NODE=http://localhost:19200

# ===== JWT / Auth =====
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Service ports =====
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
QUESTION_BANK_SERVICE_PORT=3002
EXAM_SERVICE_PORT=3003
LEARNING_SERVICE_PORT=3004
ANALYTICS_SERVICE_PORT=3005
AI_CHATBOX_SERVICE_PORT=8000

# ===== AI service =====
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AI_DAILY_MESSAGE_LIMIT=20
AI_LLM_TIMEOUT_MS=10000

# ===== Email (Mailhog) =====
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
