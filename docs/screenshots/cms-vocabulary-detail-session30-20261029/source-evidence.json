        },
        {
          "index": 236,
          "text": "/api/v1/learning/progress"
        },
        {
          "index": 237,
          "text": "Lấy tiến độ học của user."
        },
        {
          "index": 238,
          "text": ""
        },
        {
          "index": 239,
          "text": "Nghiệp vụ & thuật toán cốt lõi "
        },
        {
          "index": 240,
          "text": "SRS yêu cầu SM-2. Với chất lượng trả lời q từ 0 đến 5, hệ số dễ nhớ được cập nhật theo công thức:"
        },
        {
          "index": 241,
          "text": "EF_new = EF_old + (0.1 - (5-q) * (0.08 + (5-q)*0.02))"
        },
        {
          "index": 242,
          "text": "Quy tắc chính: nếu q < 3 thì chu kỳ lặp lại được reset; nếu q >= 3 thì tăng repetition và tính lại interval/nextReviewDate. Giao diện có thể quy đổi đánh giá đơn giản về thang q phù hợp, nhưng giá trị lưu trữ nên giữ được mức 0-5 để đúng thuật toán."
        },
        {
          "index": 243,
          "text": "Review Today: truy vấn user_vocabulary_progress với next_review_date <= thời điểm hiện tại."
        },
        {
          "index": 244,
          "text": "Lesson completion: cập nhật user_lesson_progress và phát LessonCompletedEvent."
        },
        {
          "index": 245,
          "text": "Vocabulary review: cập nhật user_vocabulary_progress và phát VocabularyLearnedEvent khi đạt điều kiện nghiệp vụ tương ứng."
        },
        {
          "index": 246,
          "text": "DỊCH VỤ LỊCH SỬ & THỐNG KÊ"
        },
        {
          "index": 247,
          "text": "Mục đích: nhận các sự kiện từ các service nghiệp vụ, lưu lịch sử và tạo các chỉ số tiến độ học tập. SRS nêu các nhóm thông tin như lịch sử điểm, streak, weak areas và dự đoán điểm TOEIC"
        },
        {
          "index": 248,
          "text": "Thiết kế Cơ sở dữ liệu "
        },
        {
          "index": 249,
          "text": "Bảng"
        },
        {
          "index": 250,
          "text": "Trường chính"
        },
        {
          "index": 251,
          "text": "Mục đích"
        },
        {
          "index": 252,
          "text": "user_statistics"
        },
        {
          "index": 253,
          "text": "user_id, learning_streak_days, longest_streak, vocabularies_learned, grammar_lessons_completed, mock_test_count, predicted_toeic_score, updated_at"
        },
        {
          "index": 254,
          "text": "Tổng hợp tiến độ và streak."
        },
        {
          "index": 255,
          "text": "processed_events"
        },
        {
          "index": 256,
          "text": "event_id, event_type, processed_at"
        }
      ]
    }
