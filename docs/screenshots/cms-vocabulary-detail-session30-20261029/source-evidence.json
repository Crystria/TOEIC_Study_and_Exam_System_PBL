        },
        {
          "index": 222,
          "text": "Gửi chất lượng nhớ q và cập nhật SM-2."
        },
        {
          "index": 223,
          "text": "GET"
        },
        {
          "index": 224,
          "text": "/api/v1/learning/lessons"
        },
        {
