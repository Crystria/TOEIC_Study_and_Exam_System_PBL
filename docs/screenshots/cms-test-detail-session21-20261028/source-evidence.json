        "text": "Đề thi: test_id, title, type FULL_TEST/MINI_TEST, duration_seconds, timestamps, deleted_at"
      },
      {
        "paragraph": 286,
        "text": "PK test_id; title/type/duration bắt buộc"
      },
      {
        "paragraph": 287,
        "text": "FULL_TEST 120 phút và 200 câu; MINI_TEST 30 phút"
      },
      {
        "paragraph": 288,
        "text": "TestQuestion"
      },
      {
        "paragraph": 289,
        "text": "Cấu trúc đề: test_id, question_id logic, position"
      },
      {
        "paragraph": 290,
        "text": "PK ghép (test_id, question_id); UNIQUE (test_id, position)"
      },
      {
        "paragraph": 291,
        "text": "N-N Test-Question; question_id được xác thực qua gRPC, không FK sang quest_db"
      }
    ],
