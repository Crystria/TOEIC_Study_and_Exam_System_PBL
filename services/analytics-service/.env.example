NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://toeic:toeic@localhost:5432/analytics_db?schema=public
REDIS_URL=redis://localhost:7379
RABBITMQ_URL=amqp://toeic:toeic@localhost:5772
JWT_ISSUER=toeic-auth
JWT_AUDIENCE=toeic-api
# V2-only Analytics queue: analytics-service.v2. Legacy routes are not bound.
ANALYTICS_CONSUMER_ENABLED=true
# Optional domain namespace; must differ from AUTHORIZATION_QUEUE_PREFIX.
# ANALYTICS_QUEUE_PREFIX=local-domain

# P1: RSA access JWT; public key only outside Auth. Paths relative to service cwd.
JWT_ACCESS_PUBLIC_KEY_FILE=../../secrets/jwt-access-public.pem

AUTH_SERVICE_SECRET_FILE=../../secrets/auth-service-secret.key
AUTH_INTERNAL_URL=http://localhost:3001
