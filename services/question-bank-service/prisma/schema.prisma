generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionGroupAssetKind {
  AUDIO
  IMAGE
  TEXT
}

model Question {
  id              String    @id @default(uuid()) @map("question_id")
  part            Int
  type            String
  questionText    String?   @map("question_text")
  explanation     String?
  difficulty      String
  correctOption   String    @map("correct_option")
  groupId         String?   @map("group_id")
  positionInGroup Int?      @map("position_in_group")
  transcript      String?
  audioKey        String?   @map("audio_key")
  imageKey        String?   @map("image_key")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  options QuestionOption[]
  tags    QuestionTag[]
  group   QuestionGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([groupId, positionInGroup])
  @@index([part, difficulty])
  @@index([part, deletedAt])
  @@index([groupId])
  @@map("questions")
}

model QuestionGroup {
  id          String    @id @default(uuid()) @map("group_id")
  part        Int
  type        String
  instruction String?
  audioKey    String?   @map("audio_key")
  transcript  String?
  passageText String?   @map("passage_text")
  orderNo     Int?      @map("order_no")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  questions Question[]
  assets    QuestionGroupAsset[]

  @@index([part, deletedAt])
  @@index([orderNo])
  @@map("question_groups")
}

model QuestionGroupAsset {
  id         String                 @id @default(uuid()) @map("asset_id")
  groupId    String                 @map("group_id")
  kind       QuestionGroupAssetKind
  storageKey String?                @map("storage_key")
  content    String?
  orderNo    Int                    @map("order_no")
  createdAt  DateTime               @default(now()) @map("created_at")

  group QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, orderNo])
  @@index([groupId])
  @@map("question_group_assets")
}

model QuestionOption {
  questionId String   @map("question_id")
  optionCode String   @map("option_code")
  optionText String   @map("option_text")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, optionCode])
  @@map("question_options")
}

model Tag {
  id        String        @id @default(uuid()) @map("tag_id")
  name      String        @unique @map("tag_name")
  questions QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String   @map("question_id")
  tagId      String   @map("tag_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  aggregateType  String    @default("unknown") @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")
  retryCount     Int       @default(0) @map("retry_count")
  lastError      String?   @map("last_error")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  deadLetteredAt DateTime? @map("dead_lettered_at")

  @@index([publishedAt])
  @@index([aggregateId])
  @@index([publishedAt, deadLetteredAt, nextAttemptAt])
  @@map("outbox_events")
}
