generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GrammarLessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VocabularySessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELED
  EXPIRED
}

model VocabularyTopic {
  id           String              @id @default(uuid())
  name         String
  description  String?
  deletedAt    DateTime?           @map("deleted_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  vocabularies Vocabulary[]
  sessions     VocabularySession[]

  @@map("vocabulary_topics")
}

model Vocabulary {
  id             String                   @id @default(uuid())
  topicId        String                   @map("topic_id")
  word           String
  wordKey        String                   @map("normalized_word")
  definitionKey  String                   @map("normalized_definition")
  phonetic       String?                  @map("phonetic")
  definition     String
  example        String?
  legacyAudioUrl String?                  @map("audio_url")
  legacyImageUrl String?                  @map("image_url")
  audioKey       String?                  @map("audio_key")
  imageKey       String?                  @map("image_key")
  deletedAt      DateTime?                @map("deleted_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  topic          VocabularyTopic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  legacyProgress LegacyUserProgress[]
  progress       UserVocabularyProgress[]
  items          VocabularySessionItem[]
  uploads        LearningUpload[]

  @@index([topicId])
  @@map("vocabularies")
}

model GrammarLesson {
  id              String                 @id @default(uuid())
  lessonTitle     String                 @map("lesson_title")
  slug            String                 @unique
  contentMarkdown String                 @map("content_markdown")
  legacyLevel     String                 @map("level")
  category        String
  status          GrammarLessonStatus    @default(DRAFT)
  deletedAt       DateTime?              @map("deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  legacyProgress  LegacyLessonProgress[]
  progress        UserLessonProgress[]

  @@index([legacyLevel, status])
  @@map("grammar_lessons")
}

// Legacy progress/sessions remain intact; never fabricate quality, quiz or firstLearned history.
model LegacyUserProgress {
  id             String     @id @default(uuid())
  userId         String     @map("user_id")
  vocabularyId   String     @map("vocabulary_id")
  easinessFactor Float      @default(2.5) @map("easiness_factor")
  repetition     Int        @default(0)
  interval       Int        @default(1)
  nextReviewAt   DateTime?  @map("next_review_at")
  lastReviewAt   DateTime?  @map("last_review_at")
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@map("user_progress")
}

model LegacyLessonProgress {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  lessonId    String        @map("lesson_id")
  status      String        @default("IN_PROGRESS")
  completedAt DateTime?     @map("completed_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lesson      GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model LearningSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int       @default(0) @map("duration_seconds")

  @@index([userId])
  @@map("learning_sessions")
}

model UserVocabularyProgress {
  userId           String     @map("user_id")
  vocabularyId     String     @map("vocabulary_id")
  quality          Int
  intervalDays     Int        @map("interval_days")
  easinessFactor   Decimal    @map("easiness_factor") @db.Decimal(4, 2)
  repetitionNumber Int        @map("repetition_number")
  nextReviewDate   DateTime   @map("next_review_date") @db.Date
  firstLearnedAt   DateTime?  @map("first_learned_at")
  revision         BigInt     @default(1)
  updatedAt        DateTime   @map("updated_at")
  vocabulary       Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)

  @@id([userId, vocabularyId])
  @@index([userId, nextReviewDate])
  @@map("user_vocabulary_progress")
}

model UserLessonProgress {
  userId      String        @map("user_id")
  lessonId    String        @map("lesson_id")
  status      String        @default("COMPLETED")
  completedAt DateTime      @map("completed_at")
  updatedAt   DateTime      @map("updated_at")
  revision    BigInt        @default(1)
  lesson      GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([userId, lessonId])
  @@map("user_lesson_progress")
}

model VocabularySession {
  id          String                  @id @default(uuid())
  userId      String                  @map("user_id")
  topicId     String                  @map("topic_id")
  mode        String
  status      VocabularySessionStatus @default(IN_PROGRESS)
  startedAt   DateTime                @map("started_at")
  expiresAt   DateTime                @map("expires_at")
  completedAt DateTime?               @map("completed_at")
  operationId String?                 @map("operation_id")
  submitHash  String?                 @map("submit_hash")
  result      Json?
  topic       VocabularyTopic         @relation(fields: [topicId], references: [id], onDelete: Restrict)
  items       VocabularySessionItem[]

  @@index([userId, startedAt])
  @@map("vocabulary_sessions")
}

model VocabularySessionItem {
  sessionId        String            @map("session_id")
  vocabularyId     String            @map("vocabulary_id")
  questionId       String            @unique @map("question_id")
  position         Int
  expectedRevision BigInt            @map("expected_revision")
  quality          Int?
  snapshot         Json
  options          Json
  correctOption    String            @map("correct_option")
  selectedOption   String?           @map("selected_option")
  quizCorrect      Boolean?          @map("quiz_correct")
  session          VocabularySession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  vocabulary       Vocabulary        @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)

  @@id([sessionId, vocabularyId])
  @@unique([sessionId, position])
  @@map("vocabulary_session_items")
}

model OperationLedger {
  userId      String   @map("user_id")
  operationId String   @map("operation_id")
  actionHash  String   @map("action_hash")
  kind        String
  status      String   @default("APPLIED")
  reason      String?
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([userId, operationId])
  @@map("operation_ledger")
}

model ContentIdempotency {
  actorId     String   @map("actor_id")
  scope       String
  key         String
  requestHash String   @map("request_hash")
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([actorId, scope, key])
  @@map("content_idempotency")
}

model ContentAudit {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  entityId      String   @map("entity_id")
  action        String
  before        Json?
  after         Json?
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@map("content_audit_logs")
}

model LearningUpload {
  id           String     @id
  ownerId      String     @map("owner_id")
  vocabularyId String     @map("vocabulary_id")
  kind         String
  objectKey    String     @unique @map("object_key")
  contentType  String     @map("content_type")
  sizeBytes    Int        @map("size_bytes")
  expiresAt    DateTime   @map("expires_at")
  confirmedAt  DateTime?  @map("confirmed_at")
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("learning_uploads")
}

model LearningStorageGarbage {
  objectKey   String   @id @map("object_key")
  deleteAfter DateTime @map("delete_after")

  @@map("learning_storage_garbage")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  retryCount    Int       @default(0) @map("retry_count")
  nextAttemptAt DateTime  @default(dbgenerated("timezone('UTC'::text, now())")) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  leaseOwner    String?   @map("lease_owner")
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox_events")
}

model LearningProgressHead {
  userId  String @id @map("user_id")
  version BigInt @default(0)

  @@map("learning_progress_heads")
}

model SyncResolution {
  userId      String @map("user_id")
  operationId String @map("operation_id")
  syncVersion BigInt @map("sync_version")
  actionHash  String @map("action_hash")
  result      Json
  envelope    Json

  @@id([userId, operationId, syncVersion])
  @@map("sync_resolutions")
}
