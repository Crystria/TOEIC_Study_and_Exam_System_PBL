NODE_ENV=development
PORT=3004
DATABASE_URL=postgresql://toeic:toeic@localhost:5432/learning_db?schema=public
REDIS_URL=redis://localhost:7379
RABBITMQ_URL=amqp://toeic:toeic@localhost:5772

# P1: RSA access JWT; public key only outside Auth. Paths relative to service cwd.
JWT_ACCESS_PUBLIC_KEY_FILE=../../secrets/jwt-access-public.pem

AUTH_SERVICE_SECRET_FILE=../../secrets/auth-service-secret.key
AUTH_INTERNAL_URL=http://localhost:3001

# P3: browser PUT/public GET use the host-visible endpoint; app talks to MinIO directly.
MINIO_ENDPOINT=http://localhost:19000
MINIO_PUBLIC_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=http://localhost:19000/toeic-media

# P4: enable only after both Auth and Learning P4 migrations are deployed.
SYNC_ENABLED=true
