NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://toeic:toeic@localhost:5432/exam_db?schema=public
REDIS_URL=redis://localhost:7379
RABBITMQ_URL=amqp://toeic:toeic@localhost:5772
JWT_ISSUER=toeic-auth
JWT_AUDIENCE=toeic-api
MEDIA_PUBLIC_BASE_URL=http://localhost:19000/toeic-media
PART_TEST_MIN_SECONDS=300
PART_TEST_MAX_SECONDS=10800
ATTEMPT_EXPIRY_GRACE_SECONDS=5
ETS_ALLOW_DEV_FALLBACK=false
QUESTION_BANK_GRPC_URL=localhost:50052
# Đường dẫn tới proto dùng chung. Để trống sẽ dùng mặc định packages/contracts/proto/question_bank.proto.
QUESTION_BANK_PROTO_PATH=

# P1: RSA access JWT; public key only outside Auth. Paths relative to service cwd.
JWT_ACCESS_PUBLIC_KEY_FILE=../../secrets/jwt-access-public.pem

AUTH_SERVICE_SECRET_FILE=../../secrets/auth-service-secret.key
AUTH_INTERNAL_URL=http://localhost:3001
