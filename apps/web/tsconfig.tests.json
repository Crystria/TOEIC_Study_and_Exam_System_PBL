{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": ".test-build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/auth-preview.ts",
    "src/lib/dashboard/types.ts",
    "src/lib/dashboard/selectors.ts",
    "src/lib/dashboard/mock-data.ts",
    "src/lib/learning/**/*.ts"
  ]
}
