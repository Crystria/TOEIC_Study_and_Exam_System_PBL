# DEMO by default. The legacy public URL alone does not enable the API bridge.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_DATA_MODE=demo
# To use the API branch, set the mode above to api and restart/rebuild.
FRONTEND_API_ENV=local
FRONTEND_GATEWAY_URL=http://127.0.0.1:3000/api/v1
FRONTEND_TEST_WRITES=disabled
# Keep false until actual Gateway/auth/headers/RBAC/response verification.
FRONTEND_METADATA_VERIFIED=false
