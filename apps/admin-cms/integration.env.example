NEXT_PUBLIC_DATA_MODE=api
FRONTEND_API_ENV=local
FRONTEND_GATEWAY_URL=http://127.0.0.1:3000/api/v1
# Content CRUD is enabled for authorized backend roles; set disabled for a read-only CMS.
FRONTEND_CONTENT_WRITES=enabled
# Account/role changes retain their separate opt-in.
FRONTEND_TEST_WRITES=disabled
# Remains false until real Gateway/auth/headers/response verification is recorded.
FRONTEND_METADATA_VERIFIED=false
